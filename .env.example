# ==============================================================================
# LIVE MARKET DATA (required for real candles — see /api/v1/market-data)
# ==============================================================================
# Twelve Data: forex, metals and crypto. Free key, ~800 credits/day.
# Register at https://twelvedata.com/pricing and put the key in .env.local.
# The key is server-side ONLY: it is never exposed to the browser.
TWELVE_DATA_API_KEY=your-twelvedata-api-key

# Deriv synthetic indices (V75, V100, Crash/Boom/Jump) need NO configuration.
# They are served from Deriv's public, no-auth market-data WebSocket, so these
# synthetics are live with no signup and no key.
#
# DERIV_APP_ID is optional and only used for quota attribution.
# DERIV_APP_ID=your-deriv-app-id
#
# An account token is only ever needed for account/trading calls, which this
# app does not make. Never commit one. If a real token was ever pushed to
# git, revoke it immediately at https://app.deriv.com/account/api-token
# DERIV_API_TOKEN=

# ==============================================================================
# APEXSMC ENVIRONMENT CONFIGURATION (.env.example)
# ==============================================================================

# Supabase Public Configuration (Safe for client-side)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.your-anon-key

# Supabase Server-Only Secret (NEVER expose to client)
SUPABASE_SERVICE_ROLE_KEY=your-service-role-secret-key

# Cloudinary Configuration for Chart Snapshots & Private Image Storage
CLOUDINARY_CLOUD_NAME=your-cloudinary-cloud-name
CLOUDINARY_API_KEY=your-cloudinary-api-key
CLOUDINARY_API_SECRET=your-cloudinary-api-secret
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=your-cloudinary-cloud-name

# Google Gemini API Key (Server-side analysis engine only)
GEMINI_API_KEY=your-gemini-api-key

# Application Settings
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_DEFAULT_SYMBOL=EURUSD
NEXT_PUBLIC_DEFAULT_TIMEFRAME=H1
NEXT_PUBLIC_DEFAULT_STRATEGY=SMC
